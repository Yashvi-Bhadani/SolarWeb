{
  "name": "raghav-solar",
  "private": true,
  "version": "1.0.0",
  "description": "Raghav Solar — full-stack website (React + Express)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --prefix frontend",
    "postinstall": "npm ci --prefix frontend --omit=dev && npm ci --prefix backend --omit=dev && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm start --prefix backend"
  }
}
