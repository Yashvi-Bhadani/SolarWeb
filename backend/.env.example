# Example backend email configuration
# If you want email delivery, fill in SMTP credentials below.
# If EMAIL_USER and EMAIL_PASS are left empty, the backend will still save contact submissions,
# but it will not send email notifications.
# For Gmail, enable 2-Step Verification and use an App Password.
# See: https://support.google.com/mail/?p=BadCredentials

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Solar Contact <your-email@example.com>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
COMPANY_EMAIL=raghav.enterpris1@gmail.com
PORT=5000
